# Ejemplo de configuración del backend — copiar a backend/.env en la mini PC
# (setup_minipc.sh genera este archivo automáticamente con SECRET_KEY aleatoria)

# Base de datos local (PostgreSQL instalado en la mini PC)
DATABASE_URL=postgresql://gestion_user:CAMBIAR_CONTRASENA@localhost:5432/gestion_db

# Clave secreta JWT: mínimo 32 caracteres (generar con: openssl rand -hex 32)
SECRET_KEY=cambiar_por_una_clave_aleatoria_de_al_menos_32_caracteres

# Orígenes CORS extra (separados por coma). El frontend y el backend
# comparten origen (puerto 8000), pero conviene listar la IP de la LAN.
ALLOWED_ORIGINS=http://localhost:8000,http://192.168.1.100:8000

# Opcionales (mismos defaults que en Render):
# EXPORT_MAX_RECORDS=200
# REPORT_MAX_RECORDS=50000
# AUDIT_RETENTION_DAYS=90
# TRASH_RETENTION_DAYS=15