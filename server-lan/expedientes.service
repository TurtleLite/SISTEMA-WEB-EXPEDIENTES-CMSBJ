[Unit]
Description=Sistema Web de Gestion de Expedientes Medicos (Centro Medico San Benito Jose)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=expedientes
WorkingDirectory=/home/expedientes/app/backend
EnvironmentFile=/home/expedientes/app/backend/.env
ExecStart=/home/expedientes/app/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target